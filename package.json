{
  "name": "airport-data-js",
  "version": "4.1.0",
  "type": "commonjs",
  "description": "A comprehensive TypeScript library providing easy retrieval of airport data based on IATA, ICAO, city codes, country codes, and continents. Includes LLM tool definitions for AI integration.",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "browser": "dist/airport-data.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./types/index.d.ts",
        "default": "./lib/index.js"
      },
      "default": "./lib/index.js"
    },
    "./lite": {
      "import": {
        "types": "./types/lite.d.mts",
        "default": "./lib/lite.mjs"
      },
      "require": {
        "types": "./types/lite.d.ts",
        "default": "./lib/lite.js"
      },
      "default": "./lib/lite.js"
    },
    "./tools": {
      "import": {
        "types": "./types/tools.d.mts",
        "default": "./lib/tools.mjs"
      },
      "require": {
        "types": "./types/tools.d.ts",
        "default": "./lib/tools.js"
      },
      "default": "./lib/tools.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "dist/airport-data.min.js",
    "dist/airport-data.lite.min.js",
    "types/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "pretest": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "build:types": "tsc --emitDeclarationOnly",
    "build:transpile": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.esm.json",
    "build:payload": "tsx scripts/build_payload.ts",
    "build:lib": "npm run build:payload && webpack --config webpack.node.cjs",
    "build:dist": "webpack --config webpack.browser.cjs",
    "build:tools": "webpack --config webpack.tools.cjs",
    "clean": "node -e \"for (const dir of ['lib','dist','types','.tsbuild','.tsbuild-esm']) require('node:fs').rmSync(dir,{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:types && npm run build:esm-types && npm run build:transpile && npm run build:lib && npm run build:dist && npm run build:tools && npm run build:esm",
    "check:duplicates": "tsx scripts/check_duplicates.ts",
    "generate:json": "tsx scripts/csv_to_json.ts",
    "generate:compressed": "tsx scripts/compress_json.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "changelog:extract": "tsx scripts/extract_latest_changelog.ts",
    "build:esm": "npm run build:payload && webpack --config webpack.esm.cjs",
    "build:esm-types": "tsx scripts/build_esm_types.ts",
    "refresh:data": "tsx scripts/refresh_ourairports.ts",
    "upgrade:https": "tsx scripts/upgrade_https.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aashishvanand/airport-data-js.git"
  },
  "keywords": [
    "airport",
    "airports",
    "iata",
    "icao",
    "flight",
    "flightradar24",
    "flightaware",
    "radarbox",
    "aviation",
    "travel",
    "geography",
    "codes",
    "continent",
    "city",
    "country",
    "aircodes",
    "amadeus",
    "ISOCountryCodes",
    "FAA",
    "timezones"
  ],
  "author": "Aashish Vivekanand",
  "license": "CC-BY-4.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "bugs": {
    "url": "https://github.com/aashishvanand/airport-data-js/issues"
  },
  "homepage": "https://airportdata.dev/",
  "overrides": {
    "brace-expansion@1": "^1.1.14",
    "brace-expansion@2": "^2.1.0",
    "ajv@8": "^8.18.0",
    "fast-uri": "^3.1.4",
    "postcss": "^8.5.18",
    "browserslist": "^4.28.7",
    "baseline-browser-mapping": "^2.11.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@babel/preset-env": "^8.0.7",
    "@types/node": "^26.6.6",
    "babel-loader": "^10.1.1",
    "csv-parse": "^7.0.3",
    "pako": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "module": "lib/index.mjs",
  "sideEffects": [
    "./lib/index.js",
    "./lib/index.mjs",
    "./lib/lite.js",
    "./lib/lite.mjs",
    "./dist/airport-data.min.js",
    "./dist/airport-data.lite.min.js"
  ]
}
