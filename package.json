{
  "name": "airport-data-js",
  "version": "4.0.0",
  "type": "commonjs",
  "description": "A comprehensive TypeScript library providing easy retrieval of airport data based on IATA, ICAO, city codes, country codes, and continents. Includes LLM tool definitions for AI integration.",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "browser": "dist/airport-data.min.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./tools": {
      "types": "./types/tools.d.ts",
      "require": "./lib/tools.js",
      "default": "./lib/tools.js"
    }
  },
  "files": [
    "lib/",
    "dist/",
    "types/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc --emitDeclarationOnly",
    "build:transpile": "tsc -p tsconfig.build.json",
    "build:lib": "webpack --config webpack.node.cjs",
    "build:dist": "webpack --config webpack.browser.cjs",
    "build:tools": "webpack --config webpack.tools.cjs",
    "build": "npm run build:types && npm run build:transpile && npm run build:lib && npm run build:dist && npm run build:tools",
    "check:duplicates": "tsx scripts/check_duplicates.ts",
    "generate:json": "tsx scripts/csv_to_json.ts",
    "generate:compressed": "tsx scripts/compress_json.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "changelog:extract": "tsx scripts/extract_latest_changelog.ts"
  },
  "dependencies": {
    "pako": "^3.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aashishvanand/airport-data-js.git"
  },
  "keywords": [
    "airport",
    "airports",
    "iata",
    "icao",
    "flight",
    "flightradar24",
    "flightaware",
    "radarbox",
    "aviation",
    "travel",
    "geography",
    "codes",
    "continent",
    "city",
    "country",
    "aircodes",
    "amadeus",
    "ISOCountryCodes",
    "FAA",
    "timezones"
  ],
  "author": "Aashish Vivekanand",
  "license": "CC BY 4.0",
  "bugs": {
    "url": "https://github.com/aashishvanand/airport-data-js/issues"
  },
  "homepage": "https://airportdata.dev/",
  "overrides": {
    "brace-expansion@1": "^1.1.14",
    "brace-expansion@2": "^2.1.0",
    "ajv@8": "^8.18.0",
    "fast-uri": "^3.1.5",
    "postcss": "^8.5.18"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@types/node": "^26.1.1",
    "babel-loader": "^10.1.1",
    "csv-parse": "^7.0.1",
    "fs-extra": "^11.4.0",
    "path-browserify": "^1.0.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1"
  }
}
